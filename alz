#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DIST="$ROOT/dist/cli/operator.js"
TSX="$ROOT/node_modules/.bin/tsx"
STATE="$ROOT/.runs/bootstrap/state.json"
# Written into dist/ as a build's last step (npm run build:complete, or bootstrap below); without it dist/ is an unfinished build.
BUILD_MARKER="$ROOT/dist/.alz-build-complete"

# The commit this checkout is at, or "unknown" outside a git checkout. A build is only trusted for the commit it was made from.
source_commit() {
  git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown
}

if [[ "${1:-}" == "bootstrap" ]]; then
  cd "$ROOT"
  umask 077
  LOG_DIR="$ROOT/.runs/bootstrap"
  mkdir -p "$LOG_DIR"
  LOG_FILE="$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ).log"
  STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  COMMIT="$(source_commit)"
  # The state file is written before the first step and rewritten at every step. Until completedAt is set, ./alz refuses
  # to run dist/, because an interrupted bootstrap leaves a partial build that must not be mistaken for a finished one.
  write_state() {
    printf '{\n  "startedAt": "%s",\n  "step": "%s",\n  "completedAt": %s,\n  "sourceCommit": "%s"\n}\n' \
      "$STARTED_AT" "$1" "$2" "$COMMIT" >"$STATE.tmp"
    mv -f "$STATE.tmp" "$STATE"
  }
  # The build's own completion marker, the same three fields `npm run build:complete` writes, for the bootstrapped commit.
  write_build_marker() {
    mkdir -p "$ROOT/dist"
    printf '{\n  "schemaVersion": 1,\n  "sourceCommit": "%s",\n  "completedAt": "%s"\n}\n' "$COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$BUILD_MARKER.tmp"
    mv -f "$BUILD_MARKER.tmp" "$BUILD_MARKER"
  }
  DONE=0
  # The terminal, kept on its own descriptor: a stop signal arrives while the build's output is redirected to the log.
  exec 3>&1
  # The detailed log is kept whatever happens: a stop signal or a failure still copies it to latest.log.
  finish() {
    cp -f "$LOG_FILE" "$LOG_DIR/latest.log" 2>/dev/null || true
    if (( DONE == 0 )); then
      echo "Local setup did not finish. Review .runs/bootstrap/latest.log, then run ./alz bootstrap again." >&3
      echo "No infrastructure changes were made." >&3
    fi
  }
  trap finish EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  write_state "npm ci" null
  echo "Preparing Sovereign ALZ local model interface..."
  build_local() {
    npm ci || return $?
    write_state "npm run build" null
    # The marker goes before every build step and comes back only after the last one, so dist/ carries its own state
    # even if .runs/ is deleted while a build is half done.
    rm -f "$BUILD_MARKER"
    npm run build
    local build_exit=$?
    if (( build_exit != 0 )); then return "$build_exit"; fi
    write_state "npm run build:ui" null
    rm -f "$BUILD_MARKER"
    npm run build:ui
    local ui_exit=$?
    if (( ui_exit != 0 )); then return "$ui_exit"; fi
    write_build_marker
  }
  if build_local >"$LOG_FILE" 2>&1; then
    write_state "done" "\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
    DONE=1
    echo "Ready. Open the private local workspace with ./alz"
    echo "Detailed build log: .runs/bootstrap/latest.log"
    exit 0
  else
    code=$?
    exit "$code"
  fi
fi

cd "$ROOT"

if [[ "${1:-}" == "debug" && -x "$TSX" ]]; then
  export ALZ_DEBUG_SOURCE=1
  export NODE_OPTIONS="${NODE_OPTIONS:-} --enable-source-maps"
  exec "$TSX" "$ROOT/src/cli/operator.ts" "$@"
fi

refuse_build() {
  echo "The local build is not ready: ./alz bootstrap did not finish, or the source changed after it ran."
  echo "Run: ./alz bootstrap"
  # dist/ is not trusted, so neither help nor doctor runs from it; the source copies do, where the dev tools exist.
  if [[ -x "$TSX" ]]; then echo "Until then, ./alz debug help and ./alz debug doctor run from the source files."; fi
  exit 2
}

if [[ -f "$DIST" ]]; then
  # A build made by ./alz bootstrap is run only when that bootstrap finished and the source has not moved since.
  # A build made another way (no state file: a released archive, CI's own npm steps) is run when it carries the build's
  # own completion marker, which every finished build writes last and an interrupted one never has.
  if [[ -f "$STATE" ]]; then
    if ! node -e '
      const fs = require("node:fs");
      let state;
      try { state = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch { process.exit(1); }
      const finished = typeof state.completedAt === "string" && state.completedAt.length > 0;
      process.exit(finished && state.sourceCommit === process.argv[2] ? 0 : 1);
    ' "$STATE" "$(source_commit)"; then
      refuse_build
    fi
  fi
  if [[ ! -f "$BUILD_MARKER" ]]; then refuse_build; fi
  exec node "$DIST" "$@"
fi

if [[ -x "$TSX" ]]; then
  exec "$TSX" "$ROOT/src/cli/operator.ts" "$@"
fi

echo "Agent Private Landing Zone is not bootstrapped."
echo "Run: ./alz bootstrap"
exit 2
