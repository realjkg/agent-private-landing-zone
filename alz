#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DIST="$ROOT/dist/cli/operator.js"
TSX="$ROOT/node_modules/.bin/tsx"

if [[ "${1:-}" == "bootstrap" ]]; then
  cd "$ROOT"
  umask 077
  LOG_DIR="$ROOT/.runs/bootstrap"
  mkdir -p "$LOG_DIR"
  LOG_FILE="$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ).log"
  echo "Preparing Sovereign ALZ local model interface..."
  if (npm ci && npm run build && npm run build:ui) >"$LOG_FILE" 2>&1; then
    cp "$LOG_FILE" "$LOG_DIR/latest.log"
    echo "Ready. Open the private local workspace with ./alz"
    echo "Detailed build log: .runs/bootstrap/latest.log"
    exit 0
  else
    code=$?
    cp "$LOG_FILE" "$LOG_DIR/latest.log"
    echo "Local setup failed. Review .runs/bootstrap/latest.log"
    echo "No infrastructure changes were made."
    exit "$code"
  fi
fi

cd "$ROOT"

if [[ "${1:-}" == "debug" && -x "$TSX" ]]; then
  export ALZ_DEBUG_SOURCE=1
  export NODE_OPTIONS="${NODE_OPTIONS:-} --enable-source-maps"
  exec "$TSX" "$ROOT/src/cli/operator.ts" "$@"
fi

if [[ -f "$DIST" ]]; then
  exec node "$DIST" "$@"
fi

if [[ -x "$TSX" ]]; then
  exec "$TSX" "$ROOT/src/cli/operator.ts" "$@"
fi

echo "Agent Private Landing Zone is not bootstrapped."
echo "Run: ./alz bootstrap"
exit 2
