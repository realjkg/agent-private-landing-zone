{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ]
}
