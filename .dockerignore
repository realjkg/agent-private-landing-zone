# A canary's local install and init folders (the committed canaries under qualification/ are copied for the tests).
qualification/**/node_modules
qualification/**/.terraform
qualification/**/*.tfvars*
!qualification/**/*.example*
qualification/**/*.tfstate*
qualification/**/*.tfplan
