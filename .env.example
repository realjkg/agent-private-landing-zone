# Model configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
ROUTER_MODEL=qwen3:1.7b
PRIMARY_MODEL=qwen3:4b
VALIDATOR_MODEL=mistral-nemo:latest
DISAGREEMENT_THRESHOLD=0.35

# Observability surface (spec: Turning On Observability Controls, section 2)
# Structured operational events on stdout as JSON lines. Default: true.
# Invalid values fail toward the default (on) with a warn line.
ALZ_OBSERVABILITY_EVENTS=true
# Loopback-only bind host for the health/readiness/metrics endpoints. Fixed
# to 127.0.0.1; any other value is refused with a warn line. Loopback-only is
# a sovereignty requirement, not a preference.
ALZ_HEALTH_HOST=127.0.0.1
# Optional fixed port for the health server. Unset picks an ephemeral port
# (0 also binds a random free port). Invalid values are ignored with a warn.
#ALZ_HEALTH_PORT=
# Optional monitoring export binding, opt-in. Provider must be a
# direct-event-export provider (OTEL_COLLECTOR or SPLUNK_HEC). The binding is
# validated against runtime-profile sovereignty rules before any event leaves
# the process and fails closed: an invalid or sovereignty-violating binding
# disables export with a single warn line. Credentials are only ever opaque
# references (secret://, vault://, keyring://) — never raw values.
#ALZ_MONITORING_PROVIDER=OTEL_COLLECTOR
#ALZ_MONITORING_DEPLOYMENT=LOCAL
#ALZ_MONITORING_ENDPOINT=http://127.0.0.1:4318
#ALZ_MONITORING_AUTH_REF=secret://monitoring/collector-auth
