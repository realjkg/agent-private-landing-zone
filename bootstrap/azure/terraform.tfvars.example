# Copy to terraform.tfvars (ignored by git) and replace every fake value. All values below are placeholders.
tenant_id = "00000000-0000-0000-0000-000000000000"
location  = "eastus2"

# The three-stage chain (the default). For the DEV-only pilot (the contract's "enabledEnvironments": ["DEV"]) write
#   enabled_environments = ["DEV"]
# and delete the QA and PROD entries below, in environments and in every oidc_subjects block: they are refused, not ignored.
# DEV-only mode also requires DEV's apply_resource_group_name, so APPLY and DISCOVERY stay on that pilot resource group.
enabled_environments = ["DEV", "QA", "PROD"]

environments = {
  DEV = {
    subscription_id            = "00000000-0000-0000-0000-000000000001"
    state_resource_group_name  = "rg-alz-pilot-state-dev"
    state_storage_account_name = "examplealzstatedev"
    apply_resource_group_name  = "rg-alz-pilot-dev" # required in DEV-only mode; in the chain, omitting it scopes APPLY and DISCOVERY to the whole subscription
  }
  QA = {
    subscription_id            = "00000000-0000-0000-0000-000000000002"
    state_resource_group_name  = "rg-alz-pilot-state-qa"
    state_storage_account_name = "examplealzstateqa"
    apply_resource_group_name  = "rg-alz-pilot-qa"
  }
  PROD = {
    subscription_id            = "00000000-0000-0000-0000-000000000003"
    state_resource_group_name  = "rg-alz-pilot-state-prod"
    state_storage_account_name = "examplealzstateprod"
    apply_resource_group_name  = "rg-alz-pilot-prod"
  }
}

# GitHub OIDC with one GitHub environment per identity and stage. Replace OWNER/REPO.
oidc_subjects = {
  DISCOVERY = {
    DEV  = "repo:OWNER/REPO:environment:dev-discovery"
    QA   = "repo:OWNER/REPO:environment:qa-discovery"
    PROD = "repo:OWNER/REPO:environment:prod-discovery"
  }
  STATE = {
    DEV  = "repo:OWNER/REPO:environment:dev-state"
    QA   = "repo:OWNER/REPO:environment:qa-state"
    PROD = "repo:OWNER/REPO:environment:prod-state"
  }
  STATE_WRITE = {
    DEV  = "repo:OWNER/REPO:environment:dev-state-write"
    QA   = "repo:OWNER/REPO:environment:qa-state-write"
    PROD = "repo:OWNER/REPO:environment:prod-state-write"
  }
  APPLY = {
    DEV  = "repo:OWNER/REPO:environment:dev-apply"
    QA   = "repo:OWNER/REPO:environment:qa-apply"
    PROD = "repo:OWNER/REPO:environment:prod-apply"
  }
}

# Optional budget (one per enabled subscription). The start date must be the first day of a month.
# budget_monthly_amount = 100
# budget_start_date     = "2026-11-01T00:00:00Z"
# alert_emails          = ["owner@example.invalid"]

# Public egress IPs or CIDRs of the pilot runner. The state accounts deny every other network.
state_allowed_ip_ranges = ["203.0.113.10"]

# Azure Bicep path (DEV only, owner decision E2; docs/act-pilot-bicep.md). Needs enabled_environments = ["DEV"] and a DEV
# apply_resource_group_name. Adds one custom role at the DEV pilot group, assigned to APPLY only. Off by default.
# bicep_deployment_stacks = true
